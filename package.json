{
  "name": "api-client",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ts-standard && tsc",
    "dev": "nodemon --watch src --ext ts --exec \"ts-standard --fix src/**/*.ts\"",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "prepack": "tsc",
    "prepare": "tsc",
    "test": "vitest",
    "clean-reinstall": "rm -rf node_modules && yarn install"
  },
  "ts-standard": {
    "project": "./tsconfig.json",
    "ignore": [
      "dist",
      "node_modules",
      "test"
    ]
  },
  "keywords": [
    "utility",
    "library",
    "api"
  ],
  "author": "CBD Secretariat",
  "license": "MIT",
  "dependencies": {
    "http-status-codes": "^2.3.0",
    "lodash-es": "^4.17.21",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "nodemon": "^3.1.10",
    "ts-standard": "^12.0.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
